/dts-v1/;
#include <dt-bindings/regulator/qcom,rpmh-regulator.h>
#include <dt-bindings/pinctrl/qcom,pmic-gpio.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include "sm8450.dtsi"
#include "pm8350.dtsi"
#include "pm8350c.dtsi"

/delete-node/ &xbl_sc_mem;
/delete-node/ &rmtfs_mem;
/delete-node/ &oem_vm_mem;

/ {
	model = "Lenovo Legion Y700 Gen 2 (TB320FC) shell bring-up";
	compatible = "lenovo,tb320fc", "qcom,sm8475", "qcom,sm8450",
		     "qcom,cape-mtp", "qcom,cape", "qcom,mtp";
	chassis-type = "tablet";
	/* TODO: Remove downstream *-id */
	qcom,msm-id = <0x213 0x10000>;
	qcom,board-id = <0x10008 0>;
	/* TODO: merge this flag during vendor_boot building */
	/* region_country is mandatory as bootloader accept either ROW or PRC */
	region_country = "ROW";

	/delete-node/ memory@a0000000;
	memory {
		device_type = "memory";
		reg = <0 0x80000000 0 0x6a000000>,
		      <0 0xed900000 0 0x12700000>,
		      <8 0x00000000 0 0x39900000>,
		      <9 0x00000000 1 0x80000000>,
		      <8 0x40000000 0 0xc0000000>;
	};

	aliases {
		serial0 = &uart7;
		i2c5 = &i2c5;
		mmc0 = &sdhc_2;
	};
	chosen {
		stdout-path = "serial0:115200n8";
		framebuffer@b8000000 {
			compatible = "simple-framebuffer";
			memory-region = <&splash_region>;
			width = <1600>;
			height = <2560>;
			stride = <6400>;
			format = "x8r8g8b8";
			status = "okay";
		};
	};

	vph_pwr: regulator-vph-pwr {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-min-microvolt = <3700000>;
		regulator-max-microvolt = <3700000>;
		regulator-always-on;
	};

	reserved-memory {
		splash_region: splash_region {
			reg = <0 0xb8000000 0 0x2b00000>;
			no-map;
		};
		ramoops@a7ce00000 {
			compatible = "ramoops";
			reg = <0xa 0x7ce00000 0 0x200000>;
			pmsg-size = <0x200000>;
			mem-type = <2>;
		};
	};
};

&xbl_ramdump_mem { reg = <0 0x80640000 0 0x1c0000>; };
&uefi_log_mem { reg = <0 0x808e4000 0 0x10000>; };
&gcc { compatible = "qcom,sm8475-gcc"; };

&apps_rsc {
	regulators-0 {
		compatible = "qcom,pm8350-rpmh-regulators";
		qcom,pmic-id = "b";
		vdd-s10-supply = <&vph_pwr>;
		vdd-s12-supply = <&vph_pwr>;
		vdd-l2-l7-supply = <&vreg_bob>;
		vdd-l3-l5-supply = <&vreg_bob>;
		vreg_s10b_1p8: smps10 {
			regulator-name = "vreg_s10b_1p8";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
		};
		vreg_s12b_1p25: smps12 {
			regulator-name = "vreg_s12b_1p25";
			regulator-min-microvolt = <1224000>;
			regulator-max-microvolt = <1400000>;
		};
		vreg_l2b_3p072: ldo2 {
			regulator-name = "vreg_l2b_3p072";
			regulator-min-microvolt = <3072000>;
			regulator-max-microvolt = <3072000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
		vreg_l5b_0p88: ldo5 {
			regulator-name = "vreg_l5b_0p88";
			regulator-min-microvolt = <880000>;
			regulator-max-microvolt = <880000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
	regulators-1 {
		compatible = "qcom,pm8350c-rpmh-regulators";
		qcom,pmic-id = "c";
		vdd-bob-supply = <&vph_pwr>;
		vdd-l6-l9-l11-supply = <&vreg_bob>;
		vdd-l10-supply = <&vreg_s12b_1p25>;
		vreg_bob: bob {
			regulator-name = "vreg_bob";
			regulator-min-microvolt = <3008000>;
			regulator-max-microvolt = <3960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_AUTO>;
		};
		vreg_l10c_1p2: ldo10 {
			regulator-name = "vreg_l10c_1p2";
			regulator-min-microvolt = <1200000>;
			regulator-max-microvolt = <1200000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
		vreg_l6c_2p96: ldo6 {
			regulator-name = "vreg_l6c_2p96";
			regulator-min-microvolt = <2960000>;
			regulator-max-microvolt = <2960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
		vreg_l9c_2p96: ldo9 {
			regulator-name = "vreg_l9c_2p96";
			regulator-min-microvolt = <2960000>;
			regulator-max-microvolt = <2960000>;
			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
		};
	};
};

&qupv3_id_0 { status = "okay"; };
&gpi_dma0 { status = "okay"; };
&uart7 { status = "okay"; };
&i2c5 {
	status = "okay";
	repeater: redriver@4f {
		compatible = "nxp,ptn3222";
		reg = <0x4f>;
		#phy-cells = <0>;
		vdd1v8-supply = <&vreg_s10b_1p8>;
		vdd3v3-supply = <&vreg_l2b_3p072>;
		reset-gpios = <&pm8350c_gpios 7 GPIO_ACTIVE_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&repeater_reset>;
	};
};

&pm8350c_gpios {
	repeater_reset: repeater-reset-state {
		pins = "gpio7";
		function = "normal";
		power-source = <1>;
		bias-disable;
		output-high;
	};
};

&usb_1_hsphy {
	compatible = "qcom,sm8475-snps-eusb2-phy", "qcom,sm8550-snps-eusb2-phy";
	reg = <0 0x088e3000 0 0x154>;
	vdd-supply = <&vreg_l5b_0p88>;
	vdda12-supply = <&vreg_l10c_1p2>;
	phys = <&repeater>;
	status = "okay";
};

&usb_1 {
	status = "okay";
	dr_mode = "peripheral";
	maximum-speed = "high-speed";
	qcom,select-utmi-as-pipe-clk;
	phys = <&usb_1_hsphy>;
	phy-names = "usb2-phy";
	/delete-property/ usb-role-switch;
};

&sdhc_2 {
	cd-gpios = <&tlmm 92 GPIO_ACTIVE_HIGH>;
	pinctrl-names = "default", "sleep";
	pinctrl-0 = <&sdc2_default_state &sdc2_card_detect>;
	pinctrl-1 = <&sdc2_sleep_state &sdc2_card_detect>;
	vmmc-supply = <&vreg_l9c_2p96>;
	vqmmc-supply = <&vreg_l6c_2p96>;
	max-frequency = <50000000>;
	no-1-8-v;
	no-sdio;
	no-mmc;
	status = "okay";
};

&sdc2_default_state {
	cmd-pins {
		drive-strength = <10>;
	};
	data-pins {
		drive-strength = <10>;
	};
};

&tlmm {
	sdc2_card_detect: sd-card-detect-state {
		pins = "gpio92";
		function = "gpio";
		drive-strength = <2>;
		bias-pull-up;
		input-enable;
	};
};

&qup_spi4_data_clk {
	drive-strength = <6>;
	bias-disable;
};

&spi4 {
	status = "okay";

	touchscreen@0 {
		compatible = "novatek,nt36523n";
		reg = <0>;
		spi-max-frequency = <1000000>;
		interrupts-extended = <&tlmm 21 IRQ_TYPE_EDGE_RISING>;
		irq-gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
		firmware-name = "novatek/tb320fc-nt36523n.bin";
		touchscreen-size-x = <16001>;
		touchscreen-size-y = <25601>;
	};
};
